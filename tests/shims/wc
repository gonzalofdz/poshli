#
# A shell function as the last command of a pipeline reports status 256 under
# ksh93, which would hide the byte-count mismatch path. This executable keeps
# the wc simulations independent of the shell that runs them.

case ${POSHLI_TEST_WC_MODE:-} in
	missing) exit 127 ;;
	wrong) printf '%s\n' '3'; exit 0 ;;
	*) exit 1 ;;
esac
